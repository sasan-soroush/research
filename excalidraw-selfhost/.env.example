# Hostname Caddy serves and gets a Let's Encrypt certificate for.
# Point a DNS A/AAAA record at this server first, and open ports 80 and 443.
SITE_ADDRESS=draw.example.com

# Full URL users open; baked into the frontend build as the collab server URL.
# Changing it requires a rebuild: docker compose build excalidraw
PUBLIC_URL=https://draw.example.com
